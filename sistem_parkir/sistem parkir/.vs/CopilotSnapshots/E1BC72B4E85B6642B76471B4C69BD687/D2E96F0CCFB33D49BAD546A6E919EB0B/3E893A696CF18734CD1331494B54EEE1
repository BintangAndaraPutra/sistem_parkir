        private void InitializeDatabase()
        {
            Directory.CreateDirectory(Application.UserAppDataPath);
            if (!File.Exists(databaseFile))
            {
                using (var con = new SqlConnection(masterConnection))
                using (var cmd = new SqlCommand("CREATE DATABASE [ParkirDb] ON PRIMARY (NAME = N'ParkirDb', FILENAME = N'" + databaseFile.Replace("'", "''") + "')", con))
                {
                    con.Open(); cmd.ExecuteNonQuery();
                }
            }
            using (var con = new SqlConnection(databaseConnection))
            using (var cmd = new SqlCommand(@"IF OBJECT_ID('dbo.ParkingTransactions') IS NULL
                CREATE TABLE dbo.ParkingTransactions (Id INT IDENTITY(1,1) PRIMARY KEY, VehicleType NVARCHAR(20) NOT NULL, PlateNumber NVARCHAR(12) NOT NULL, EntryTime DATETIME NOT NULL, ExitTime DATETIME NULL, TotalCost INT NULL);", con))
            { con.Open(); cmd.ExecuteNonQuery(); }
        }

        private void Masuk_Click(object sender, EventArgs e)
        {
            string plat = txtPlat.Text.Trim();
            if (plat.Length == 0) { MessageBox.Show("Masukkan plat nomor kendaraan.", "Validasi", MessageBoxButtons.OK, MessageBoxIcon.Information); txtPlat.Focus(); return; }
            using (var con = new SqlConnection(databaseConnection))
            using (var cmd = new SqlCommand("INSERT INTO ParkingTransactions (VehicleType, PlateNumber, EntryTime) VALUES (@jenis,@plat,@waktu)", con))
            {
                cmd.Parameters.AddWithValue("@jenis", jenisTerpilih); cmd.Parameters.AddWithValue("@plat", plat); cmd.Parameters.AddWithValue("@waktu", DateTime.Now);
                con.Open(); cmd.ExecuteNonQuery();
            }
            txtPlat.Clear(); LoadActiveVehicles();
        }

        private void Keluar_Click(object sender, EventArgs e)
        {
            string plat = txtPlat.Text.Trim();
            if (plat.Length == 0) { MessageBox.Show("Masukkan plat nomor kendaraan yang keluar.", "Validasi", MessageBoxButtons.OK, MessageBoxIcon.Information); txtPlat.Focus(); return; }
            using (var con = new SqlConnection(databaseConnection))
            using (var cmd = new SqlCommand("SELECT TOP 1 Id, VehicleType, EntryTime FROM ParkingTransactions WHERE PlateNumber=@plat AND ExitTime IS NULL ORDER BY EntryTime", con))
            {
                cmd.Parameters.AddWithValue("@plat", plat); con.Open();
                using (var r = cmd.ExecuteReader())
                {
                    if (!r.Read()) { MessageBox.Show("Kendaraan aktif dengan plat tersebut tidak ditemukan.", "Informasi", MessageBoxButtons.OK, MessageBoxIcon.Information); return; }
                    int id = r.GetInt32(0); string jenis = r.GetString(1); DateTime masuk = r.GetDateTime(2); DateTime keluar = DateTime.Now;
                    int tarif = jenis == "Mobil" ? 3000 : 2000; int biayaAwal = jenis == "Mobil" ? 5000 : 3000; int jam = Math.Max(1, (int)Math.Ceiling((keluar - masuk).TotalHours)); int total = biayaAwal + ((jam - 1) * tarif);
                    r.Close();
                    using (var update = new SqlCommand("UPDATE ParkingTransactions SET ExitTime=@keluar, TotalCost=@biaya WHERE Id=@id", con))
                    { update.Parameters.AddWithValue("@keluar", keluar); update.Parameters.AddWithValue("@biaya", total); update.Parameters.AddWithValue("@id", id); update.ExecuteNonQuery(); }
                    MessageBox.Show("Kendaraan keluar. Total biaya: " + total.ToString("N0") + "", "Transaksi selesai", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            txtPlat.Clear(); LoadActiveVehicles();
        }

        private void LoadActiveVehicles()
        {
            if (grid == null || !File.Exists(databaseFile)) return;
            try
            {
                grid.Rows.Clear();
                using (var con = new SqlConnection(databaseConnection))
                using (var cmd = new SqlCommand("SELECT VehicleType, PlateNumber, EntryTime FROM ParkingTransactions WHERE ExitTime IS NULL ORDER BY EntryTime", con))
                {
                    con.Open();
                    using (var r = cmd.ExecuteReader())
                    {
                        int no = 1;

                        while (r.Read())
                        {
                            string jenis = r.GetString(0);
                            DateTime masuk = r.GetDateTime(2);
                            int biaya = jenis == "Mobil" ? 5000 : 3000;

                            grid.Rows.Add(
                                no++,
                                jenis,
                                r.GetString(1),
                                masuk.ToString("dd/MM/yyyy HH:mm"),
                                "Rp " + biaya.ToString("N0"));
                        }
                    }
                }

                // Menjaga empat baris visual seperti pada desain Figma.
                while (grid.Rows.Count < 4)
                {
                    grid.Rows.Add("", "", "", "", "");
                }
            }
            catch (SqlException) { }
        }
